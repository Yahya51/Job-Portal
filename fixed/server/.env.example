# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already git-ignored.

# A long, random string. Generate one with: openssl rand -base64 32
JWT_SECRET=

# MongoDB Atlas connection string (create a NEW database user + password,
# do not reuse any credentials that were ever shared publicly)
MONGODB_URI=

# Cloudinary (Dashboard > Settings > API Keys)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Clerk (Dashboard > API Keys)
CLERK_WEBHOOK_SECRET=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

PORT=5000
